# ---------------------------------------------------------------------------
# BackTrack — environment variables
#
#   cp .env.example .env
#
# ./setup.sh creates this file for you and generates a random AUTH_SECRET and
# database password. Everything below has a working local default except the
# secrets, which must never be committed.
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by docker-compose.yml) -------------------------------
POSTGRES_USER="backtrack"
POSTGRES_PASSWORD="change-me-locally"
POSTGRES_DB="backtrack_dev"
# 5433 by default so the container cannot collide with a Postgres you already
# run on the standard 5432.
POSTGRES_PORT="5433"

# --- Prisma ----------------------------------------------------------------
# Must match the values above.
DATABASE_URL="postgresql://backtrack:change-me-locally@127.0.0.1:5433/backtrack_dev?schema=public"

# --- Auth.js ---------------------------------------------------------------
# Signs session cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Optional: Google sign-in ----------------------------------------------
# Leave blank to hide the Google button entirely.
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- File storage ----------------------------------------------------------
# "local" writes to ./uploads/{pdfs,images} and serves through /api/files/[id].
# Implement another StorageProvider in src/lib/storage/ to move to S3 or R2.
STORAGE_DRIVER="local"

# --- Seed accounts ---------------------------------------------------------
# Created by `npm run db:seed`. CHANGE THESE before deploying anywhere public.
SEED_ADMIN_EMAIL="admin@backtrack.local"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_STUDENT_EMAIL="student@backtrack.local"
SEED_STUDENT_PASSWORD="Student@12345"
